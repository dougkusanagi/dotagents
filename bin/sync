#!/usr/bin/env bash
# Gera AGENTS.md no diretório de estado (regras + índice de memórias + local.md + blocos externos)
# e CLAUDE.md (o mesmo, sem blocos externos: o Claude Code já recebe as
# instruções dos servidores MCP, como o lerd) e aponta os arquivos globais de
# cada agente para o arquivo dele.
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
AGENTS_HOME="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
source "$AGENTS_HOME/bin/paths"
MEMORY_DIR="$DOTAGENTS_DATA/memory"
BUILD_DIR="$DOTAGENTS_STATE"
EXTERNAL_DIR="$BUILD_DIR/external"
OUT="$BUILD_DIR/AGENTS.md"
OUT_CLAUDE="$BUILD_DIR/CLAUDE.md"
INDEX_CAP="${INDEX_CAP:-30}"

# "arquivo global do agente|arquivo gerado". Só é ligado se o diretório do agente existir.
TARGETS=(
  "$HOME/.claude/CLAUDE.md|$OUT_CLAUDE"
  "$HOME/.codex/AGENTS.md|$OUT"
  "$DOTAGENTS_XDG_CONFIG/opencode/AGENTS.md|$OUT"
  "$HOME/.gemini/GEMINI.md|$OUT"
)

# Reconhece perfis convencionais sem confundir qualquer pasta com um perfil.
for profile in "$HOME"/.codex_* "$HOME"/.codex-*; do
  [[ -d "$profile" && ( -f "$profile/config.toml" || -f "$profile/auth.json" ) ]] || continue
  TARGETS+=("$profile/AGENTS.md|$OUT")
done

# CODEX_HOME também permite perfis fora dos nomes convencionais.
if [[ -n "${CODEX_HOME:-}" && "$CODEX_HOME" != "$HOME/.codex" ]]; then
  [[ "$CODEX_HOME" == /* ]] || { echo 'erro: CODEX_HOME deve ser um caminho absoluto' >&2; exit 1; }
  found_profile=no
  for pair in "${TARGETS[@]}"; do
    [[ "${pair%%|*}" != "${CODEX_HOME%/}/AGENTS.md" ]] || found_profile=yes
  done
  [[ "$found_profile" == yes ]] || TARGETS+=("${CODEX_HOME%/}/AGENTS.md|$OUT")
fi

# Copia blocos <!-- nome:begin --> … <!-- nome:end --> escritos por outras
# ferramentas (ex.: lerd) para build/external/nome.md, para sobreviverem à regeração.
extract_blocks() {
  awk -v dir="$EXTERNAL_DIR" '
    !name && /^<!-- [A-Za-z0-9_.-]+:begin/ {
      n = $0; sub(/^<!-- /, "", n); sub(/:begin.*/, "", n)
      if (n != "memory") { name = n; file = dir "/" name ".md" }
    }
    name { print > file }
    name && index($0, "<!-- " name ":end") == 1 { close(file); name = "" }
  ' "$1"
}

# Valor de um campo do frontmatter YAML (só a forma simples "chave: valor").
field() {
  awk -v k="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    index($0, k ":") == 1 { v = substr($0, length(k) + 2); gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit }
  ' "$1"
}

build_index() {
  local f desc tags rel lines count
  lines="$(
    for f in "$MEMORY_DIR"/*.md; do
      [[ -e "$f" ]] || continue
      rel="$MEMORY_DIR/$(basename "$f")"
      desc="$(field "$f" description | sed 's/^"\(.*\)"$/\1/')"
      tags="$(field "$f" applies_to | tr -d '[]"'"'"' ')"
      if [[ -z "$desc" ]]; then
        echo "aviso: $rel sem description no frontmatter" >&2
        desc="$(basename "$f" .md)"
      fi
      # Ordem estável (sem tag primeiro, depois por tag e arquivo) para não invalidar o cache de prompt.
      printf '%s\t%s\t- %s%s (%s)\n' "${tags:-}" "$rel" "${tags:+[$tags] }" "$desc" "$rel"
    done | LC_ALL=C sort | cut -f3
  )"
  count=0
  [[ -n "$lines" ]] && count="$(printf '%s\n' "$lines" | wc -l)"

  echo "<!-- memory:begin -->"
  echo "### Índice de memórias"
  echo
  if (( count == 0 )); then
    echo "_Nenhuma memória ainda._"
  else
    printf '%s\n' "$lines"
  fi
  if (( count > INDEX_CAP )); then
    echo
    echo "⚠ Índice acima do teto ($count/$INDEX_CAP): consolide memórias antes de acrescentar outras."
    echo "aviso: índice com $count memórias (teto $INDEX_CAP)" >&2
  fi
  echo "<!-- memory:end -->"
}

link_target() {
  local target="$1" out="$2" backup
  [[ -d "$(dirname "$target")" ]] || return 0
  if [[ -L "$target" && "$(readlink "$target")" == "$out" ]]; then
    return 0
  fi
  if [[ -f "$target" && ! -L "$target" ]]; then
    backup="$(mktemp "$target.bak-$(date +%Y%m%d%H%M%S)-XXXX")"
    cp -p "$target" "$backup"
    echo "backup: $backup"
  fi
  ln -sfn "$out" "$target"
  echo "link: $target -> $out"
}

# Escreve um arquivo gerado; o segundo argumento diz se inclui os blocos externos.
write_out() {
  local out="$1" with_external="$2" index="$3" block line
  {
    echo "<!-- Gerado por $AGENTS_HOME/bin/sync. Edite $AGENTS_HOME/global.md, local.md ou memory/ e rode dotagents-sync. -->"
    echo
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line//\~\/.local\/share\/dotagents\/memory/"$MEMORY_DIR"}"
      printf '%s\n' "${line//<dotagents>/"$AGENTS_HOME"}"
    done < "$AGENTS_HOME/global.md"
    echo
    printf '%s\n' "$index"
    if [[ -f "$DOTAGENTS_CONFIG/local.md" ]]; then
      echo
      cat "$DOTAGENTS_CONFIG/local.md"
    fi
    if [[ "$with_external" == yes ]]; then
      for block in "$EXTERNAL_DIR"/*.md; do
        [[ -e "$block" ]] || continue
        echo
        cat "$block"
      done
    fi
  } > "$out.tmp"
  mv "$out.tmp" "$out"
}

main() {
  local pair target out index
  mkdir -p "$EXTERNAL_DIR" "$MEMORY_DIR"
  exec 9> "$BUILD_DIR/.sync.lock"
  flock 9

  # Blocos externos: primeiro os dos arquivos gerados (uma ferramenta pode ter
  # escrito através do link), depois os de arquivos globais que não são mais
  # link para o arquivo deles (uma ferramenta pode ter substituído o link).
  for out in "$OUT" "$OUT_CLAUDE"; do
    [[ -f "$out" ]] && extract_blocks "$out"
  done
  for pair in "${TARGETS[@]}"; do
    target="${pair%%|*}" out="${pair#*|}"
    if [[ -e "$target" && "$(readlink -f "$target")" != "$out" ]]; then
      extract_blocks "$target"
    fi
  done

  index="$(build_index)"
  write_out "$OUT" yes "$index"
  write_out "$OUT_CLAUDE" no "$index"

  for pair in "${TARGETS[@]}"; do
    link_target "${pair%%|*}" "${pair#*|}"
  done

  if [[ -d "$MEMORY_DIR/.git" && -n "$(git -C "$MEMORY_DIR" status --porcelain)" ]]; then
    git -C "$MEMORY_DIR" add -A
    git -C "$MEMORY_DIR" commit -qm "memória: sync $(date +%F)" \
      || echo "aviso: não foi possível commitar memory/" >&2
  fi

  echo "ok: $OUT, $OUT_CLAUDE"
}

main "$@"
