#!/usr/bin/env bash
# Run the updated script from the legacy clone, after reviewing its inventory.
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$REPO/bin/paths"
DEST="${1:?uso: bin/migrate /caminho/absoluto/do/repositorio}"
[[ "$REPO" == "$HOME/.agents" ]] || { echo 'erro: execute no clone antigo em ~/.agents' >&2; exit 1; }
[[ "$DEST" == /* && "$DEST" != "$REPO" && "$DEST" != "$REPO/"* ]] || { echo 'erro: destino absoluto fora de ~/.agents obrigatório' >&2; exit 1; }
[[ ! -e "$DEST" && ! -L "$DEST" ]] || { echo "erro: destino existente: $DEST" >&2; exit 1; }
# No destination may collide; preserve complete repositories, including empty ones.
for entry in "$DOTAGENTS_DATA/memory" "$DOTAGENTS_CONFIG/local.md" "$DOTAGENTS_STATE"; do
  [[ ! -e "$entry" && ! -L "$entry" ]] || { echo "erro: destino existente: $entry" >&2; exit 1; }
done
# Refuse unknown files rather than silently moving another tool's data.
while IFS= read -r -d '' entry; do
  name="${entry##*/}"
  case "$name" in .git|skills|memory|local.md|build) continue ;; esac
  git -C "$REPO" ls-files --error-unmatch -- "$name" >/dev/null 2>&1 || {
    echo "erro: arquivo não versionado precisa de revisão: $entry" >&2; exit 1;
  }
done < <(find "$REPO" -mindepth 1 -maxdepth 1 -print0)
mkdir -p "$DEST" "$DOTAGENTS_DATA" "$DOTAGENTS_CONFIG" "$(dirname "$DOTAGENTS_STATE")"
# Copy state before moving the clone so blocks survive broken legacy symlinks.
if [[ -d "$REPO/build" ]]; then cp -a "$REPO/build" "$DOTAGENTS_STATE"; fi
[[ ! -e "$REPO/memory" ]] || mv "$REPO/memory" "$DOTAGENTS_DATA/memory"
[[ ! -e "$REPO/local.md" ]] || mv "$REPO/local.md" "$DOTAGENTS_CONFIG/local.md"
while IFS= read -r -d '' entry; do
  case "${entry##*/}" in skills|build) continue ;; esac
  mv "$entry" "$DEST/"
done < <(find "$REPO" -mindepth 1 -maxdepth 1 -print0)
"$DEST/install.sh"
# Retain legacy build if installation fails; remove only after success.
rm -rf -- "$REPO/build"
echo "migração concluída: $DEST; skills preservado em $REPO/skills"
